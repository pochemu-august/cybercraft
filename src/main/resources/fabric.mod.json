{
	"schemaVersion": 1,
	"id": "cybercraft",
	"version": "${version}",
	"name": "Cybercraft",
	"description": "Cyberpunk netrunning mod for Fabric Loader: neuro-visors, scanning HUD, ICE protocols, and remote quickhacks.",
	"authors": [
		"augustuz"
	],
	"contact": {
		"homepage": "https://github.com/augustuz/cybercraft",
		"sources": "https://github.com/augustuz/cybercraft"
	},
	"license": "MIT",
	"icon": "assets/cybercraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cybercraft.Cybercraft"
		],
		"client": [
			"com.cybercraft.client.CybercraftClient"
		],
		"fabric-datagen": [
			"com.cybercraft.client.CybercraftDataGenerator"
		]
	},
	"mixins": [
		"cybercraft.mixins.json",
		{
			"config": "cybercraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}